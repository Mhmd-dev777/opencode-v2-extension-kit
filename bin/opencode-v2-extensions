#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$ROOT_DIR/config/plugins.json"
PROFILES="$ROOT_DIR/config/profiles.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/opencode-v2-extensions"
STATE_FILE="$STATE_DIR/managed.json"
CONFIG_DIR="${OPENCODE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"
MODE="safe"; DRY_RUN=0; YES=0; PROFILE="safe"; ACTION="status"
usage(){ cat <<'EOF'
Usage: opencode-v2-extensions <install|remove|status|doctor|render|list-profiles> [options]

install       Install selected, verified package plugins through OpenCode v2.
remove        Remove only plugins recorded by this script.
render        Generate config/generated/opencode-v2-extensions.jsonc without installing.
doctor        Validate OpenCode v2 and the research manifest.
status        Show every extension's research status and managed state.
list-profiles List the available customization profiles.

Options:
  --profile NAME      safe, productivity, memory, ui, workflow, all-known
  --allow-risky       include researched entries needing review (never V1/unresolved)
  --all               alias for --profile all-known --allow-risky
  --dry-run           print operations without changing the host
  --yes               skip confirmation
EOF
}
log(){ printf '[opencode-v2-extensions] %s\n' "$*"; }
fail(){ printf '[opencode-v2-extensions] ERROR: %s\n' "$*" >&2; exit 1; }
need_cmd(){ command -v "$1" >/dev/null 2>&1 || fail "'$1' is required."; }
check_opencode(){ need_cmd opencode; local v; v="$(opencode --version 2>/dev/null || true)"; [[ -n "$v" ]] || fail "OpenCode is installed but its version cannot be read. Install OpenCode v2 first."; [[ "$v" =~ (^|[^0-9])2([.][0-9]+|[^0-9]|$) ]] || fail "OpenCode v2 is required; detected: $v. This tool never installs OpenCode."; opencode plugin --help >/dev/null 2>&1 || fail "Current OpenCode lacks plugin management."; printf '%s\n' "$v"; }
parse(){ while (($#)); do case "$1" in --profile) shift; PROFILE="${1:-}";; --allow-risky) MODE="risky";; --all) MODE="all"; PROFILE="all-known";; --dry-run) DRY_RUN=1;; --yes) YES=1;; -h|--help) usage; exit 0;; install|remove|uninstall|status|doctor|render|list-profiles) ACTION="$1";; *) fail "Unknown argument: $1";; esac; shift; done; }
select_json(){ python3 - "$MANIFEST" "$PROFILES" "$PROFILE" "$MODE" <<'PY'
import json,sys
m=json.load(open(sys.argv[1])); profiles=json.load(open(sys.argv[2]))['profiles']; name=sys.argv[3]; mode=sys.argv[4]
if name not in profiles: raise SystemExit(f"unknown profile: {name}")
pr=profiles[name]; ids=set(pr.get('ids',[])); statuses=set(pr.get('include_status',[])); include_resolved=pr.get('include_resolved',False)
for p in m['plugins']:
  selected=(p['id'] in ids) or (p['status'] in statuses) or (include_resolved and p.get('source'))
  if selected and p.get('source') and p['status'] not in ('v1-blocked','unresolved') and (mode!='safe' or p['status']=='v2-reviewed'):
    print(json.dumps(p,ensure_ascii=False))
PY
}
render(){ mkdir -p "$ROOT_DIR/config/generated"; PROFILE_JSON="$PROFILE" MODE_JSON="$MODE" ROOT_JSON="$ROOT_DIR" python3 - "$MANIFEST" "$PROFILES" "$PROFILE" "$MODE" <<'PY'
import json,sys,os
m=json.load(open(sys.argv[1])); profiles=json.load(open(sys.argv[2]))['profiles']; name=sys.argv[3]; mode=sys.argv[4]; pr=profiles[name]; ids=set(pr.get('ids',[])); statuses=set(pr.get('include_status',[])); inc=pr.get('include_resolved',False); out=[]
for p in m['plugins']:
 if not p.get('source') or p['status'] in ('v1-blocked','unresolved'): continue
 if not ((p['id'] in ids) or (p['status'] in statuses) or (inc and p.get('source'))): continue
 if mode=='safe' and p['status']!='v2-reviewed': continue
 options_path=os.path.join(sys.argv[5] if len(sys.argv)>5 else os.path.dirname(os.path.dirname(sys.argv[1])), 'extensions',p['id'],'options.json')
 try: cfg=json.load(open(options_path))
 except Exception: cfg={'options':{}}
 clean={k:v for k,v in cfg.get('options',{}).items() if v not in ('',None,[],{})}
 entry=p['source'] if not clean else {'package':p['source'],'options':clean}
 out.append(entry)
path=os.path.join(os.environ.get('ROOT_JSON',os.path.dirname(os.path.dirname(sys.argv[1]))),'config/generated/opencode-v2-extensions.jsonc')
with open(path,'w') as f:
 f.write('{\n  "$schema": "https://opencode.ai/config.json",\n  "plugins": '+json.dumps(out,indent=2,ensure_ascii=False)+'\n}\n')
print(path)
PY
}
list_profiles(){ python3 - "$PROFILES" <<'PY'
import json,sys
for k,v in json.load(open(sys.argv[1]))['profiles'].items(): print(f"{k}: {v['description']}")
PY
}
confirm(){ ((YES||DRY_RUN)) && return; read -r -p "Continue with profile '$PROFILE'? [y/N] " a; [[ "$a" == y || "$a" == Y ]] || exit 0; }
install(){ check_opencode >/dev/null; mkdir -p "$STATE_DIR"; mapfile -t rows < <(select_json); ((${#rows[@]})) || fail "No eligible entries for profile '$PROFILE'. Safe mode installs only v2-reviewed entries."; local ids=() sources=(); for row in "${rows[@]}"; do id="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["id"])' "$row")"; source="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["source"])' "$row")"; command="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("install_command", ""))' "$row")"; [[ "$command" != BLOCKED:* && "$command" != BUILD_REQUIRED:* ]] || { log "SKIP $id: $command"; continue; }; ids+=("$id"); sources+=("$source"); if ((DRY_RUN)); then log "DRY RUN: opencode plugin add $source"; else opencode plugin add "$source"; fi; done; ((${#sources[@]})) || fail "Profile contains no directly installable package plugins; follow each extension README for build/port steps."; if (( ! DRY_RUN )); then export STATE_FILE; python3 - "${ids[@]}" -- "${sources[@]}" <<'PY'
import json,sys,os
sep=sys.argv.index('--'); os.makedirs(os.path.dirname(os.environ['STATE_FILE']),exist_ok=True); json.dump({'managed_ids':sys.argv[1:sep],'managed_sources':sys.argv[sep+1:]},open(os.environ['STATE_FILE'],'w'),indent=2)
PY
fi; }
remove(){ check_opencode >/dev/null; [[ -f "$STATE_FILE" ]] || fail "No managed state found; refusing to remove arbitrary plugins."; mapfile -t sources < <(python3 - "$STATE_FILE" <<'PY'
import json,sys
for x in json.load(open(sys.argv[1])).get('managed_sources',[]): print(x)
PY
); ((${#sources[@]})) || { log "Nothing managed."; return; }; confirm; for source in "${sources[@]}"; do if ((DRY_RUN)); then log "DRY RUN: opencode plugin remove $source"; else opencode plugin remove "$source" || log "WARN: removal failed for $source"; fi; done; ((DRY_RUN)) || rm -f "$STATE_FILE"; }
doctor(){ check_opencode; python3 -m json.tool "$MANIFEST" >/dev/null; python3 -m json.tool "$PROFILES" >/dev/null; log "Research manifest, profiles, and OpenCode v2 CLI are valid."; log "This tool does not install OpenCode."; }
status(){ python3 - "$MANIFEST" "$STATE_FILE" <<'PY'
import json,sys,os
m=json.load(open(sys.argv[1])); s=json.load(open(sys.argv[2])) if os.path.exists(sys.argv[2]) else {'managed_ids':[]}
for p in m['plugins']: print(f"{p['id']}: {p['status']} | {p.get('source') or 'UNRESOLVED'}")
print('Managed:', ', '.join(s.get('managed_ids',[])) or 'none')
PY
}
parse "$@"; case "$ACTION" in install) install;; remove|uninstall) remove;; doctor) doctor;; render) render;; list-profiles) list_profiles;; status) status;; esac
