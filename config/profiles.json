      "ids": [
        "tavily",
        "codebase-index"
      ]
    },
    "safe-operations": {
      "description": "Verified quota, notification, team orchestration, and memory extensions.",
      "allow_risky": false,
      "ids": [
        "quota",
        "ensemble",
        "notifier",
        "supermemory"
      ]
